# Database
DATABASE_URL="postgresql://tradenotti:tradenotti@localhost:5432/tradenotti?schema=public"

# Auth.js (NextAuth v5)
# Generate a secret with: openssl rand -base64 32
AUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional in dev)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# OpenAI — daily insights
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# Cron protection for /api/cron/daily-insight
CRON_SECRET="change-me"

# Stripe — billing (7-day trial, then the Pro subscription)
STRIPE_SECRET_KEY=""
# Webhook signing secret from the Stripe Dashboard / `stripe listen` — verifies
# requests to /api/webhooks/stripe actually came from Stripe.
STRIPE_WEBHOOK_SECRET=""
# Price ID for the Pro plan (Stripe Dashboard -> Product catalog). The dollar
# amount itself lives in lib/billing.ts (PRO_PRICE_USD) for display copy —
# keep the two in sync if the price changes.
STRIPE_PRICE_ID=""
